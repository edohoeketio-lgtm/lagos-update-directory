# Lagos Updates Directory Environment Template
# Copy this file to .env and configure your keys

# Server
PORT=3000
ADMIN_PASSKEY=lagosupdates2026
ADMIN_EMAIL=vendors@lagosupdates.com

# Flutterwave Payment Gateway (Test or Live keys from flutterwave.com)
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key-here
FLW_ENCRYPTION_KEY=FLWSECK_TEST-your-encryption-key-here

# Resend Transactional Email Service (Primary - resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Lagos Updates <onboarding@resend.dev>

# Mailgun Transactional Email Service (Legacy fallback)
MAILGUN_API_KEY=key-your-mailgun-api-key
MAILGUN_DOMAIN=mg.lagosupdates.com
MAILGUN_FROM_EMAIL=Lagos Updates Directory <noreply@lagosupdates.com>

# SMTP Fallback (Optional)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.lagosupdates.com
SMTP_PASS=your-smtp-password

# PostHog Analytics (from posthog.com)
POSTHOG_API_KEY=phx_your-posthog-project-api-key-here
POSTHOG_API_HOST=https://us.i.posthog.com

# Supabase Cloud Database & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-secret
SUPABASE_STORAGE_BUCKET=listing-photos

